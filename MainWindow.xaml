<Window x:Class="VpnEcho.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN Echo" Width="420" Height="840" MinWidth="420" MaxWidth="420" MinHeight="840" MaxHeight="840"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#111315" Foreground="#D2D6D8" FontFamily="Segoe UI"
        Closing="Window_Closing" Loaded="Window_Loaded" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#899196"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#252A2D"/><Setter Property="Foreground" Value="#D2D6D8"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#30373A"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Foreground" Value="#D2D6D8"/><Setter Property="Background" Value="#2C3436"/>
      <Setter Property="FontSize" Value="16"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="12" Padding="12">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#364043"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#405052"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="ServerListItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="ServerTemplate">
      <Border Background="{Binding RowBrush}" CornerRadius="10" Height="68" Margin="0,0,0,8" Padding="12,9" MouseLeftButtonUp="ServerRow_MouseLeftButtonUp" Cursor="Hand">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/><ColumnDefinition Width="83"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Mark}" Foreground="{Binding MarkBrush}" FontSize="19" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" Foreground="#D2D6D8" FontSize="15" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Subtitle}" Foreground="#899196" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding ValueText}" Foreground="{Binding ValueBrush}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Border BorderBrush="#303639" BorderThickness="1" Background="#111315">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
      <Grid x:Name="TopBar" Grid.Row="0" Background="#111315" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="38"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
        <TextBlock Text="echo" FontSize="29" FontWeight="Bold" Foreground="#D2D6D8" VerticalAlignment="Center" Margin="24,0,0,0"/>
        <TextBlock Grid.Column="1" Text="VPN / 1.1.1.1" FontSize="11" Foreground="#899196" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button Grid.Column="2" Style="{StaticResource ChromeButton}" Content="—" Click="Minimize_Click" ToolTip="Minimize"/>
        <Button Grid.Column="3" Style="{StaticResource ChromeButton}" Content="×" Click="Close_Click" ToolTip="Close" Margin="0,0,5,0"/>
      </Grid>
      <Grid Grid.Row="1">
        <Grid x:Name="ActivationView" Visibility="Collapsed" Margin="28">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <TextBlock Text="Welcome to Echo" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Please enter your license first." FontSize="14" Foreground="#899196" HorizontalAlignment="Center" Margin="0,14,0,30"/>
            <TextBox x:Name="LicenseInput" Height="56" Background="#1D2124" Foreground="#D2D6D8" BorderThickness="0" Padding="16,14" FontSize="16" VerticalContentAlignment="Center" TextChanged="LicenseInput_TextChanged" KeyDown="LicenseInput_KeyDown"/>
            <TextBlock x:Name="LicenseError" Height="38" Foreground="#DC7E7E" FontSize="12" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Content="Activate" Height="54" Style="{StaticResource FlatButton}" Click="Activate_Click"/>
            <TextBlock Text="Activate once. Stay ready." FontSize="12" Foreground="#899196" HorizontalAlignment="Center" Margin="0,22,0,0"/>
          </StackPanel>
        </Grid>
        <Grid x:Name="MainView" Visibility="Collapsed" Margin="20,0,20,0">
          <Grid.RowDefinitions><RowDefinition Height="196"/><RowDefinition Height="62"/><RowDefinition Height="36"/><RowDefinition Height="4"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Button x:Name="PowerButton" Grid.Row="0" Width="190" Height="190" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Background="#070909" BorderBrush="#30383B" BorderThickness="1" Click="Power_Click" Cursor="Hand">
            <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="100"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="⏻" FontSize="62" FontFamily="Segoe UI Symbol" Foreground="#D2D6D8" HorizontalAlignment="Center"/><TextBlock x:Name="PowerLabel" Text="Connect" FontSize="13" FontWeight="Medium" Foreground="#D2D6D8" HorizontalAlignment="Center" Margin="0,1,0,0"/></StackPanel>
          </Button>
          <TextBlock x:Name="DetailText" Grid.Row="1" Text="Tap Connect to test all 3 servers&#10;and connect to the best one." FontSize="12" Foreground="#899196" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="ScanLabel" Text="3 SERVERS · AUTOMATIC" FontSize="11" Foreground="#899196" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="VMESS" FontSize="10" Foreground="#66C995" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
          <ProgressBar x:Name="ScanProgress" Grid.Row="3" Height="4" IsIndeterminate="True" Foreground="#66C995" Background="#303639" BorderThickness="0" Visibility="Collapsed"/>
          <ListBox x:Name="ServerList" Grid.Row="5" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ServerListItem}" ItemTemplate="{StaticResource ServerTemplate}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        </Grid>
      </Grid>
      <TextBlock x:Name="Credit" Grid.Row="2" Text="developer: Ramtin Ahmadi" FontSize="10" Foreground="#899196" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" MouseRightButtonUp="ShowAbout_MouseRightButtonUp"/>
    </Grid>
  </Border>
</Window>
